{
  "name": "campuslife-buddy",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:mobile": "npm --workspace @campuslife/mobile run start",
    "dev:server": "npm --workspace @campuslife/server run dev",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
